{
  "name": "plataforma-trf3",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de estudos para o concurso TRF3 2026 — Técnico Judiciário (Desenvolvimento de Sistemas e Suporte Técnico)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:use-postgres": "node scripts/use-postgres.mjs",
    "content:import": "tsx --conditions=react-server scripts/import-content.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:coverage": "tsx scripts/coverage-report.ts",
    "links:check": "tsx scripts/check-links.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-vendor.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "dotenv": "^16.6.1",
    "highlight.js": "11.12.0",
    "lucide-react": "0.577.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-markdown": "10.1.0",
    "recharts": "2.15.4",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "sql.js": "1.16.0",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sql.js": "1.4.11",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
