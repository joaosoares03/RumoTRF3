# Banco de dados
# Desenvolvimento local (padrão, sem instalar nada): SQLite em arquivo
DATABASE_URL="file:./dev.db"
# Produção (PostgreSQL — ex.: Neon ou Supabase, planos gratuitos). Rode "npm run db:use-postgres" antes.
# DATABASE_URL="postgresql://usuario:senha@host:5432/trf3?sslmode=require"

# E-mails que recebem perfil de administrador ao se cadastrar (separados por vírgula).
# Se vazio, o PRIMEIRO usuário cadastrado vira administrador.
ADMIN_EMAILS=""

# Opcional: análise orientativa de redação por IA (Claude). Sem esta chave, a plataforma usa
# apenas a análise automática local (heurística), que é gratuita.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
